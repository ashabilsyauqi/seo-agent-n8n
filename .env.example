# =====================================================================
# SEO Agent (n8n): konfigurasi
# Salin ke .env (scripts/setup.sh melakukannya otomatis dan mengisi kunci acak).
# Nilai yang mengandung spasi WAJIB diberi tanda kutip.
# =====================================================================

# ---------- Rahasia (dibuat otomatis oleh setup.sh) ----------
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
# Kunci enkripsi credential n8n. JANGAN diganti setelah credential tersimpan.
N8N_ENCRYPTION_KEY=

# ---------- Model AI ----------
# Key: https://aistudio.google.com/apikey  (disimpan sebagai credential n8n, bukan env container)
GEMINI_API_KEY=
# true = ikut download Hermes 3 8B (~5 GB) ke Ollama sebagai model lokal opsional
PULL_HERMES=false
EMBEDDING_MODEL=bge-m3
# Default: Ollama di dalam Docker. Mau pakai aplikasi Ollama yang sudah terpasang di Mac (lebih cepat)?
# Isi http://host.docker.internal:11434 lalu jalankan: ollama pull bge-m3 && ./scripts/import.sh --with-credentials
OLLAMA_URL=http://ollama:11434

# ---------- Website ----------
SITE_NAME=Difitech
SITE_DOMAIN=difitech.id
WP_BASE_URL=https://difitech.id
# Endpoint REST WordPress yang di-index (pisahkan dengan koma), mis. posts,pages,product
WP_POST_TYPES=posts,pages
# 0 = semua. Isi kecil (mis. 20) untuk uji coba pertama yang cepat.
INGEST_MAX_PAGES=0
RESPONSE_LANGUAGE="Bahasa Indonesia"

# ---------- RAG ----------
CHUNK_SIZE=1500
RAG_TOP_K=3
RAG_FETCH_K=20
RAG_MIN_SCORE=0.50
RAG_MAX_CHARS_PER_PAGE=900

# ---------- Scraper kompetitor ----------
# Jina Reader bisa tanpa key (rate limit lebih rendah). Firecrawl dipakai bila Jina gagal & key diisi.
JINA_API_KEY=
FIRECRAWL_API_KEY=
SCRAPE_MAX_CHARS=12000
SCRAPE_CACHE_HOURS=6

# ---------- n8n ----------
N8N_VERSION=2.41.6
TZ=Asia/Jakarta
# Lokal: biarkan default. VPS: N8N_HOST=n8n.domainanda.com, N8N_PROTOCOL=https,
# WEBHOOK_URL=https://n8n.domainanda.com/, N8N_SECURE_COOKIE=true
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
N8N_BIND_IP=127.0.0.1
N8N_PUBLISH_PORT=5678
POSTGRES_PUBLISH_PORT=5433
